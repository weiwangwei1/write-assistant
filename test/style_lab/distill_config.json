  "phases": [
    {"id": "p1", "name": "基础指纹", "desc": "复用 style_fingerprint.py 提取16标量+2向量维度", "tool": "fingerprint"},
    {"id": "p2", "name": "句式模式", "desc": "句子起始类型·长短句分布·句式结构画像", "tool": "sentence"},
    {"id": "p3", "name": "段落节奏", "desc": "段落类型分布·序列模式·段长分布画像", "tool": "paragraph"},
    {"id": "p4", "name": "意象通道", "desc": "感官通道分布·意象词频率·通道叠加深度", "tool": "imagery"},
    {"id": "p5", "name": "对话风格", "desc": "对话长度·引导模式·裸对话比·对话叙述比", "tool": "dialogue"},
    {"id": "p6", "name": "修辞比喻", "desc": "比喻密度·喻体域·修辞手法分布", "tool": "metaphor"},
    {"id": "p7", "name": "叙述技法", "desc": "开篇模式·章末模式·世界自转·物件叙事", "tool": "narrative"},
    {"id": "p8", "name": "跨作者对比", "desc": "六位作者全维度雷达对比·风格距离矩阵", "tool": "compare"}
  ],

  "output": {
    "state_file": "test/style_lab/distill_state.json",

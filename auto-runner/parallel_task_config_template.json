{
  "_description": "并行任务配置模板 v1.0 — 演示6种并行模式的task_config.json配置方式。使用时根据实际角色名/章节号替换占位符。",
  "_usage": "复制对应模式的steps到task_config.json，替换{角色名}/{N}/{总角色数}等占位符。parallel_group相同的步骤会被同时启动，is_merger=true的步骤等待同组全部完成后执行。",
  "_field_reference": {
    "parallel_group": "并行组标识，同组步骤同时执行",
    "parallel_index": "组内序号（从0开始）",
    "parallel_total": "组内并行步骤总数",
    "is_merger": "true=合并步骤，等待同组全部完成后执行",
    "depends_on": "依赖的步骤ID列表，这些步骤必须completed后才能执行当前步骤",
    "agent_type": "Task工具的subagent_type，默认general_purpose_task",
    "input_files": "该步骤需要读取的文件列表",
    "output_files": "该步骤产出的文件列表（并行Agent必须写独立文件）",
    "pass_criteria": "质量门禁条件"
  },

  "patterns": {

    "pattern_1_preproduction": {
      "_name": "模式1: 预生产并行",
      "_scenario": "plot-architect产出大纲后，title-reviewer/skeptic R1/setting-reviewer可同时执行",
      "_speedup": "串行3步45min → 并行1步15min，提速3x",
      "steps": [
        {
          "id": 10,
          "name": "书名审核",
          "agent": "title-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "preproduction",
          "parallel_index": 0,
          "parallel_total": 3,
          "depends_on": [9],
          "input_files": ["memory/outline.json", ".trae/skills/title-reviewer/SKILL.md"],
          "output_files": ["handoff/title_review.json"],
          "pass_criteria": "verdict in [pass, conditional_pass]"
        },
        {
          "id": 11,
          "name": "质疑第1轮",
          "agent": "skeptic",
          "agent_type": "general_purpose_task",
          "parallel_group": "preproduction",
          "parallel_index": 1,
          "parallel_total": 3,
          "depends_on": [9],
          "input_files": ["memory/outline.json", "handoff/topic_screening.json", ".trae/skills/skeptic/SKILL.md"],
          "output_files": ["handoff/skeptic_review.json"],
          "pass_criteria": "round=1 completed"
        },
        {
          "id": 12,
          "name": "设定审核",
          "agent": "setting-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "preproduction",
          "parallel_index": 2,
          "parallel_total": 3,
          "depends_on": [9],
          "input_files": ["memory/outline.json", ".trae/skills/setting-reviewer/SKILL.md"],
          "output_files": ["handoff/setting_review.json"],
          "pass_criteria": "total_score >= 9.5"
        },
        {
          "id": 13,
          "name": "大纲验收（合并）",
          "agent": "outline-editor",
          "agent_type": "general_purpose_task",
          "parallel_group": "preproduction",
          "is_merger": true,
          "depends_on": [10, 11, 12],
          "input_files": ["memory/outline.json", "handoff/title_review.json", "handoff/skeptic_review.json", "handoff/setting_review.json", ".trae/skills/outline-editor/SKILL.md"],
          "output_files": ["handoff/outline_review.json"],
          "pass_criteria": "verdict = pass"
        }
      ]
    },

    "pattern_2_character_design": {
      "_name": "模式2: 角色并行设计",
      "_scenario": "大纲验收通过后，每个角色由独立Agent设计，最后合并关系网络",
      "_speedup": "串行6角色90min → 并行1轮15min+合并1轮15min=30min，提速3x",
      "_note": "替换{角色名}为实际角色名，{角色定位}为该角色在故事中的定位",
      "steps": [
        {
          "id": 20,
          "name": "角色设计-{角色名1}",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "parallel_index": 0,
          "parallel_total": 6,
          "depends_on": [13],
          "input_files": ["memory/outline.json", "config/novel_config.json", ".trae/skills/character-designer/SKILL.md"],
          "output_files": ["memory/characters/{角色名1}.json"],
          "pass_criteria": "角色卡包含所有必需字段",
          "agent_prompt_suffix": "只设计角色「{角色名1}」，不设计关系网络。输出到memory/characters/{角色名1}.json"
        },
        {
          "id": 21,
          "name": "角色设计-{角色名2}",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "parallel_index": 1,
          "parallel_total": 6,
          "depends_on": [13],
          "input_files": ["memory/outline.json", "config/novel_config.json", ".trae/skills/character-designer/SKILL.md"],
          "output_files": ["memory/characters/{角色名2}.json"],
          "pass_criteria": "角色卡包含所有必需字段",
          "agent_prompt_suffix": "只设计角色「{角色名2}」，不设计关系网络。输出到memory/characters/{角色名2}.json"
        },
        {
          "id": 22,
          "name": "角色设计-{角色名3}",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "parallel_index": 2,
          "parallel_total": 6,
          "depends_on": [13],
          "input_files": ["memory/outline.json", "config/novel_config.json", ".trae/skills/character-designer/SKILL.md"],
          "output_files": ["memory/characters/{角色名3}.json"],
          "pass_criteria": "角色卡包含所有必需字段",
          "agent_prompt_suffix": "只设计角色「{角色名3}」，不设计关系网络。输出到memory/characters/{角色名3}.json"
        },
        {
          "id": 23,
          "name": "角色设计-{角色名4}",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "parallel_index": 3,
          "parallel_total": 6,
          "depends_on": [13],
          "input_files": ["memory/outline.json", "config/novel_config.json", ".trae/skills/character-designer/SKILL.md"],
          "output_files": ["memory/characters/{角色名4}.json"],
          "pass_criteria": "角色卡包含所有必需字段",
          "agent_prompt_suffix": "只设计角色「{角色名4}」，不设计关系网络。输出到memory/characters/{角色名4}.json"
        },
        {
          "id": 24,
          "name": "角色设计-{角色名5}",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "parallel_index": 4,
          "parallel_total": 6,
          "depends_on": [13],
          "input_files": ["memory/outline.json", "config/novel_config.json", ".trae/skills/character-designer/SKILL.md"],
          "output_files": ["memory/characters/{角色名5}.json"],
          "pass_criteria": "角色卡包含所有必需字段",
          "agent_prompt_suffix": "只设计角色「{角色名5}」，不设计关系网络。输出到memory/characters/{角色名5}.json"
        },
        {
          "id": 25,
          "name": "角色设计-{角色名6}",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "parallel_index": 5,
          "parallel_total": 6,
          "depends_on": [13],
          "input_files": ["memory/outline.json", "config/novel_config.json", ".trae/skills/character-designer/SKILL.md"],
          "output_files": ["memory/characters/{角色名6}.json"],
          "pass_criteria": "角色卡包含所有必需字段",
          "agent_prompt_suffix": "只设计角色「{角色名6}」，不设计关系网络。输出到memory/characters/{角色名6}.json"
        },
        {
          "id": 26,
          "name": "关系网络设计（合并）",
          "agent": "character-designer",
          "agent_type": "general_purpose_task",
          "parallel_group": "char_design",
          "is_merger": true,
          "depends_on": [20, 21, 22, 23, 24, 25],
          "input_files": [
            "memory/characters/{角色名1}.json",
            "memory/characters/{角色名2}.json",
            "memory/characters/{角色名3}.json",
            "memory/characters/{角色名4}.json",
            "memory/characters/{角色名5}.json",
            "memory/characters/{角色名6}.json",
            ".trae/skills/character-designer/SKILL.md"
          ],
          "output_files": ["memory/characters.json", "handoff/characters.json"],
          "pass_criteria": "关系网络包含≥2个核心关系+演变阶段；角色间无设定冲突",
          "agent_prompt_suffix": "你是关系网络合并Agent。读取所有单角色卡，设计关系网络，合并为memory/characters.json，输出交接卡handoff/characters.json"
        }
      ]
    },

    "pattern_3_multi_chapter_review": {
      "_name": "模式3: 多章并行审核",
      "_scenario": "多个章节初稿已完成，每章1个Agent执行完整4步审核流水线",
      "_speedup": "串行5章300min → 并行1轮60min，提速5x",
      "_note": "替换{N}为章节号。每个Agent独立审核，最后由主控合并foreshadowing_tracker",
      "steps": [
        {
          "id": 30,
          "name": "Ch{N1}完整审核",
          "agent": "multi-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "batch_review",
          "parallel_index": 0,
          "parallel_total": 5,
          "depends_on": [],
          "input_files": [
            "output/chapter_00{N1}.txt",
            ".trae/skills/detail-reviewer/SKILL.md",
            ".trae/skills/quality-reviewer/SKILL.md",
            ".trae/skills/de-ai-processor/SKILL.md",
            ".trae/skills/final-reviewer/SKILL.md",
            "memory/outline.json",
            "memory/characters.json",
            "memory/foreshadowing_tracker.json"
          ],
          "output_files": [
            "handoff/detail_review_{N1}.json",
            "handoff/quality_review_{N1}.json",
            "handoff/de_ai_polish_{N1}.json",
            "handoff/final_review_{N1}.json"
          ],
          "pass_criteria": "final_review均分>=9.5",
          "agent_prompt_suffix": "你是第{N1}章审核专家。按顺序执行detail→quality→de-ai→final 4步审核。如任何步骤未通过则标注并停止后续步骤。不要修改foreshadowing_tracker.json，将伏笔更新建议写入final_review报告。"
        },
        {
          "id": 31,
          "name": "Ch{N2}完整审核",
          "agent": "multi-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "batch_review",
          "parallel_index": 1,
          "parallel_total": 5,
          "depends_on": [],
          "input_files": [
            "output/chapter_00{N2}.txt",
            ".trae/skills/detail-reviewer/SKILL.md",
            ".trae/skills/quality-reviewer/SKILL.md",
            ".trae/skills/de-ai-processor/SKILL.md",
            ".trae/skills/final-reviewer/SKILL.md",
            "memory/outline.json",
            "memory/characters.json",
            "memory/foreshadowing_tracker.json"
          ],
          "output_files": [
            "handoff/detail_review_{N2}.json",
            "handoff/quality_review_{N2}.json",
            "handoff/de_ai_polish_{N2}.json",
            "handoff/final_review_{N2}.json"
          ],
          "pass_criteria": "final_review均分>=9.5",
          "agent_prompt_suffix": "你是第{N2}章审核专家。按顺序执行detail→quality→de-ai→final 4步审核。如任何步骤未通过则标注并停止后续步骤。不要修改foreshadowing_tracker.json，将伏笔更新建议写入final_review报告。"
        },
        {
          "id": 32,
          "name": "Ch{N3}完整审核",
          "agent": "multi-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "batch_review",
          "parallel_index": 2,
          "parallel_total": 5,
          "depends_on": [],
          "input_files": [
            "output/chapter_00{N3}.txt",
            ".trae/skills/detail-reviewer/SKILL.md",
            ".trae/skills/quality-reviewer/SKILL.md",
            ".trae/skills/de-ai-processor/SKILL.md",
            ".trae/skills/final-reviewer/SKILL.md",
            "memory/outline.json",
            "memory/characters.json",
            "memory/foreshadowing_tracker.json"
          ],
          "output_files": [
            "handoff/detail_review_{N3}.json",
            "handoff/quality_review_{N3}.json",
            "handoff/de_ai_polish_{N3}.json",
            "handoff/final_review_{N3}.json"
          ],
          "pass_criteria": "final_review均分>=9.5",
          "agent_prompt_suffix": "你是第{N3}章审核专家。按顺序执行detail→quality→de-ai→final 4步审核。如任何步骤未通过则标注并停止后续步骤。不要修改foreshadowing_tracker.json，将伏笔更新建议写入final_review报告。"
        },
        {
          "id": 33,
          "name": "Ch{N4}完整审核",
          "agent": "multi-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "batch_review",
          "parallel_index": 3,
          "parallel_total": 5,
          "depends_on": [],
          "input_files": [
            "output/chapter_00{N4}.txt",
            ".trae/skills/detail-reviewer/SKILL.md",
            ".trae/skills/quality-reviewer/SKILL.md",
            ".trae/skills/de-ai-processor/SKILL.md",
            ".trae/skills/final-reviewer/SKILL.md",
            "memory/outline.json",
            "memory/characters.json",
            "memory/foreshadowing_tracker.json"
          ],
          "output_files": [
            "handoff/detail_review_{N4}.json",
            "handoff/quality_review_{N4}.json",
            "handoff/de_ai_polish_{N4}.json",
            "handoff/final_review_{N4}.json"
          ],
          "pass_criteria": "final_review均分>=9.5",

          "depends_on": [],
          "input_files": [
            "output/chapter_00{N5}.txt",
            ".trae/skills/detail-reviewer/SKILL.md",
            ".trae/skills/quality-reviewer/SKILL.md",
            ".trae/skills/de-ai-processor/SKILL.md",
            ".trae/skills/final-reviewer/SKILL.md",
            "memory/outline.json",
            "memory/characters.json",
            "memory/foreshadowing_tracker.json"
          ],
          "output_files": [
            "handoff/detail_review_{N5}.json",
            "handoff/quality_review_{N5}.json",
            "handoff/de_ai_polish_{N5}.json",
            "handoff/final_review_{N5}.json"
          ],
          "pass_criteria": "final_review均分>=9.5",
          "agent_prompt_suffix": "你是第{N5}章审核专家。按顺序执行detail→quality→de-ai→final 4步审核。如任何步骤未通过则标注并停止后续步骤。不要修改foreshadowing_tracker.json，将伏笔更新建议写入final_review报告。"
        },
        {
          "id": 35,
          "name": "伏笔追踪器合并（合并）",
          "agent": "chief-editor",
          "agent_type": "general_purpose_task",
          "parallel_group": "batch_review",
          "is_merger": true,
          "depends_on": [30, 31, 32, 33, 34],
          "input_files": [
            "handoff/final_review_{N1}.json",
            "handoff/final_review_{N2}.json",
            "handoff/final_review_{N3}.json",
            "handoff/final_review_{N4}.json",
            "handoff/final_review_{N5}.json",
            "memory/foreshadowing_tracker.json"
          ],
          "output_files": ["memory/foreshadowing_tracker.json"],
          "pass_criteria": "所有章节伏笔状态已更新，无冲突",
          "agent_prompt_suffix": "你是伏笔追踪器合并Agent。读取所有章节的final_review报告中的伏笔更新建议，统一合并到memory/foreshadowing_tracker.json。检查伏笔状态是否有冲突。"
        }
      ]
    },

    "pattern_4_intra_chapter_parallel": {
      "_name": "模式4: 单章审核内部并行",
      "_scenario": "单章审核中detail-reviewer和de-ai-processor可并行（内容vs语言），quality和final串行在后",
      "_speedup": "串行4步60min → 并行45min，提速1.3x",
      "_note": "detail和de-ai都输出修改建议而非直接改文件，由合并步骤统一应用",
      "steps": [
        {
          "id": 40,
          "name": "Ch{N}细节审核",
          "agent": "detail-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": "intra_review_{N}",
          "parallel_index": 0,
          "parallel_total": 2,
          "depends_on": [],
          "input_files": [
            "output/chapter_00{N}.txt",
            "memory/outline.json",
            "memory/characters.json",
            ".trae/skills/detail-reviewer/SKILL.md"
          ],
          "output_files": ["handoff/detail_review_{N}.json"],
          "pass_criteria": "overall_verdict in [polished, needs_revision]",
          "agent_prompt_suffix": "只输出修改建议到handoff/detail_review_{N}.json，不要直接修改chapter_00{N}.txt"
        },
        {
          "id": 41,
          "name": "Ch{N}去AI味分析",
          "agent": "de-ai-processor",
          "agent_type": "general_purpose_task",
          "parallel_group": "intra_review_{N}",
          "parallel_index": 1,
          "parallel_total": 2,
          "depends_on": [],
          "input_files": [
            "output/chapter_00{N}.txt",
            ".trae/skills/de-ai-processor/SKILL.md"
          ],
          "output_files": ["handoff/de_ai_analysis_{N}.json"],
          "pass_criteria": "ai_score <= 2.0",
          "agent_prompt_suffix": "只输出AI痕迹分析和修改建议到handoff/de_ai_analysis_{N}.json，不要直接修改chapter_00{N}.txt"
        },
        {
          "id": 42,
          "name": "Ch{N}修改合并（合并）",
          "agent": "chapter-writer",
          "agent_type": "general_purpose_task",
          "parallel_group": "intra_review_{N}",
          "is_merger": true,
          "depends_on": [40, 41],
          "input_files": [
            "output/chapter_00{N}.txt",
            "handoff/detail_review_{N}.json",
            "handoff/de_ai_analysis_{N}.json"
          ],
          "output_files": ["output/chapter_00{N}.txt"],
          "pass_criteria": "所有critical/major问题已修复",
          "agent_prompt_suffix": "读取detail_review和de_ai_analysis的修改建议，统一应用到chapter_00{N}.txt。优先处理critical，再处理major，minor酌情处理。"
        },
        {
          "id": 43,
          "name": "Ch{N}宏观评分",
          "agent": "quality-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": null,
          "depends_on": [42],
          "input_files": [
            "output/chapter_00{N}.txt",
            "memory/outline.json",
            "memory/characters.json",
            ".trae/skills/quality-reviewer/SKILL.md"
          ],
          "output_files": ["handoff/quality_review_{N}.json"],
          "pass_criteria": "技术分>=9.5"
        },
        {
          "id": 44,
          "name": "Ch{N}终审",
          "agent": "final-reviewer",
          "agent_type": "general_purpose_task",
          "parallel_group": null,
          "depends_on": [43],
          "input_files": [
            "output/chapter_00{N}.txt",
            "handoff/quality_review_{N}.json",
            ".trae/skills/final-reviewer/SKILL.md"
          ],
          "output_files": ["handoff/final_review_{N}.json"],
          "pass_criteria": "均分>=9.5"
        }
      ]
    },

    "pattern_5_multi_chapter_writing": {
      "_name": "模式5: 多章并行写作",
      "_scenario": "beat sheet已就绪，多章同时写作，完成后连续性检查",
      "_speedup": "串行3章90min → 并行1轮30min+检查15min=45min，提速2x",
      "_warning": "高风险模式！beat sheet必须非常详细。最多并行3章。",
      "steps": [
        {
          "id": 50,
          "name": "写Ch{N1}",
          "agent": "chapter-writer",
          "agent_type": "general_purpose_task",
          "parallel_group": "batch_write",
          "parallel_index": 0,
          "parallel_total": 3,
          "depends_on": [],
          "input_files": [
            "memory/outline.json",
            "memory/characters.json",
            "handoff/beat_sheet_{N1}.json",
            ".trae/skills/chapter-writer/SKILL.md"
          ],
          "output_files": ["output/chapter_00{N1}.txt"],
          "pass_criteria": "字数达标+每句单独一行",
          "agent_prompt_suffix": "严格按照beat_sheet_{N1}.json执行。开头方式:{开头类型}，结尾类型:{结尾类型}。不要修改其他章节文件。"
        },
        {
          "id": 51,
          "name": "写Ch{N2}",
          "agent": "chapter-writer",
